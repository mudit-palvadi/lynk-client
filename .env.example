# Copy this file to .env and point API_BASE_URL at your own local backend.
# See README.md for the full local setup.

# Android emulator (10.0.2.2 reaches the host machine):
API_BASE_URL=http://10.0.2.2:8000/api/v1/

# Web or desktop:
# API_BASE_URL=http://localhost:8000/api/v1/

# Physical Android device after `adb reverse tcp:8000 tcp:8000`,
# or replace the host with your computer's LAN IP:
# API_BASE_URL=http://localhost:8000/api/v1/

# Public product links.
PRIVACY_POLICY_URL=https://sites.google.com/view/lynk-privacy-policy/
DEEP_LINK_BASE_URL=https://lynkshare.app

# Do not add storage credentials, publishing tokens or signing keys here:
# this file is bundled into the app. Debug and profile builds use Google's
# test ad identifiers automatically.
