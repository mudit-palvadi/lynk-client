<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Debug builds may talk to a plaintext backend (the local API on
        http://10.0.2.2:8000 during development). The release manifest sets
        usesCleartextTraffic="false", so this override is what re-enables
        cleartext for debug builds only. It is deliberately absent from the
        profile and release variants.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
