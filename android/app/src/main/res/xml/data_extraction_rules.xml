<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer rules for LynkShare.

    The app deliberately keeps no data outside app-private storage that is
    safe to restore onto another device: recent transfer names/paths, the
    device UUID and the selected folder URI all identify this installation.
    Exclude every domain from both cloud backup and device-to-device transfer
    so these rules agree with android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
