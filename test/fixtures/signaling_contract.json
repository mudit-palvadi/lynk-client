{
  "version": 1,
  "cases": [
    {"name":"offer preserves SDP bytes","raw":"{\"sdp\":\"v=0\\r\\ns=lynk\\r\\n\",\"type\":\"offer\",\"ignored\":true}","expected":{"type":"offer","sdp":"v=0\r\ns=lynk\r\n"}},
    {"name":"answer preserves whitespace","raw":"{\"type\":\"answer\",\"sdp\":\" v=0 answer \"}","expected":{"type":"answer","sdp":" v=0 answer "}},
    {"name":"full candidate canonical order","raw":"{\"type\":\"candidate\",\"candidate\":{\"sdpMLineIndex\":0,\"sdpMid\":\"data\",\"candidate\":\"candidate:1 1 UDP 1 192.0.2.1 5000 typ host\",\"ignored\":true}}","expected":{"type":"candidate","candidate":{"candidate":"candidate:1 1 UDP 1 192.0.2.1 5000 typ host","sdpMid":"data","sdpMLineIndex":0}}},
    {"name":"candidate optional fields omitted","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\"}}","expected":{"type":"candidate","candidate":{"candidate":"c"}}},
    {"name":"candidate optional fields null","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMid\":null,\"sdpMLineIndex\":null}}","expected":{"type":"candidate","candidate":{"candidate":"c","sdpMid":null,"sdpMLineIndex":null}}},
    {"name":"end of candidates empty string","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"\",\"sdpMid\":\"0\"}}","expected":{"type":"candidate","candidate":{"candidate":"","sdpMid":"0"}}},
    {"name":"integral JSON number canonicalized","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":0.0}}","expected":{"type":"candidate","candidate":{"candidate":"c","sdpMLineIndex":0}}},
    {"name":"maximum unsigned short index","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":65535}}","expected":{"type":"candidate","candidate":{"candidate":"c","sdpMLineIndex":65535}}},
    {"name":"offer missing SDP","raw":"{\"type\":\"offer\"}","expected":{"type":"error"}},
    {"name":"offer null SDP","raw":"{\"type\":\"offer\",\"sdp\":null}","expected":{"type":"error"}},
    {"name":"offer numeric SDP","raw":"{\"type\":\"offer\",\"sdp\":7}","expected":{"type":"error"}},
    {"name":"offer empty SDP","raw":"{\"type\":\"offer\",\"sdp\":\"\"}","expected":{"type":"error"}},
    {"name":"offer blank SDP","raw":"{\"type\":\"offer\",\"sdp\":\" \\r\\n \"}","expected":{"type":"error"}},
    {"name":"answer array SDP","raw":"{\"type\":\"answer\",\"sdp\":[]}","expected":{"type":"error"}},
    {"name":"answer blank SDP","raw":"{\"type\":\"answer\",\"sdp\":\" \"}","expected":{"type":"error"}},
    {"name":"candidate envelope missing","raw":"{\"type\":\"candidate\"}","expected":{"type":"error"}},
    {"name":"candidate envelope null","raw":"{\"type\":\"candidate\",\"candidate\":null}","expected":{"type":"error"}},
    {"name":"candidate envelope array","raw":"{\"type\":\"candidate\",\"candidate\":[]}","expected":{"type":"error"}},
    {"name":"candidate envelope string","raw":"{\"type\":\"candidate\",\"candidate\":\"c\"}","expected":{"type":"error"}},
    {"name":"candidate value missing","raw":"{\"type\":\"candidate\",\"candidate\":{}}","expected":{"type":"error"}},
    {"name":"candidate value null","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":null}}","expected":{"type":"error"}},
    {"name":"candidate value numeric","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":1}}","expected":{"type":"error"}},
    {"name":"mid must be string or null","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMid\":0}}","expected":{"type":"error"}},
    {"name":"index must be numeric","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":\"0\"}}","expected":{"type":"error"}},
    {"name":"index must not be boolean","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":false}}","expected":{"type":"error"}},
    {"name":"index must be integral","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":0.5}}","expected":{"type":"error"}},
    {"name":"index must be nonnegative","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":-1}}","expected":{"type":"error"}},
    {"name":"index must fit unsigned short","raw":"{\"type\":\"candidate\",\"candidate\":{\"candidate\":\"c\",\"sdpMLineIndex\":65536}}","expected":{"type":"error"}},
    {"name":"unknown type","raw":"{\"type\":\"auth\",\"token\":\"test-only\"}","expected":{"type":"error"}},
    {"name":"missing type","raw":"{}","expected":{"type":"error"}},
    {"name":"top level null","raw":"null","expected":{"type":"error"}},
    {"name":"top level array","raw":"[]","expected":{"type":"error"}},
    {"name":"invalid JSON","raw":"not-json{","expected":{"type":"error"}}
  ]
}
